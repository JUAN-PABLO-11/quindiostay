	<field name="NACIMIENTO_MENOR" class="java.lang.String"/>
	<title><band height="180"><rectangle><reportElement mode="Opaque" backcolor="#2E5E3A" forecolor="#2E5E3A" x="0" y="0" width="540" height="46" uuid="f899139d-f5e1-0593-9643-1415e770c6dd"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle><staticText><reportElement forecolor="#FFFFFF" x="12" y="4" width="260" height="24" uuid="ef41d488-7553-6731-6f04-fc0e0e9dc9fc"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="18" isBold="true" isItalic="false"/></textElement><text><![CDATA[QuindioStay]]></text></staticText><staticText><reportElement forecolor="#DDE8DF" x="12" y="26" width="300" height="16" uuid="9ffeb5b7-64e8-84cc-28fe-f0104e64b5bc"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false"/></textElement><text><![CDATA[Plataforma de turismo del Quindío]]></text></staticText><staticText><reportElement forecolor="#FFFFFF" x="260" y="4" width="270" height="22" uuid="78a01b29-d6ee-b247-5698-5624ac5723c9"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true" isItalic="false"/></textElement><text><![CDATA[Autorización de viaje]]></text></staticText><textField isBlankWhenNull="true"><reportElement forecolor="#FFFFFF" x="260" y="26" width="270" height="16" uuid="34ea6ce7-740b-e2f2-9ffb-d939cfda02aa"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA["Menores de edad · Reserva N.º " + $F{ID_RESERVA}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="60" width="540" height="92" uuid="0b7e2607-202c-b7ca-fc1a-fda7ba96a535"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Top"><font size="10" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA["Yo, " + $F{CLIENTE} + ", identificado(a) con " + $F{DOC_CLIENTE} + ", en calidad de padre, madre o representante legal, " + "AUTORIZO a los menores de edad relacionados a continuación a viajar en el paquete turístico \"" + $F{PAQUETE} + "\" (plan " + $F{PLAN} + "), con destino " + $F{DESTINO} + ", entre el " + $F{FECHA_SALIDA} + " y el " + $F{FECHA_REGRESO} + ", organizado por " + $F{AGENCIA} + " (NIT " + $F{NIT} + ", RNT " + $F{NUMERO_RNT} + "). Declaro que viajarán acompañados por al menos un adulto registrado en la misma reserva, que conozco el itinerario y las actividades, y que la información suministrada es verídica."]]></textFieldExpression></textField><staticText><reportElement positionType="Float" mode="Opaque" backcolor="#7A4E2D" forecolor="#FFFFFF" x="0" y="158" width="240" height="18" uuid="427ed8dc-e514-b1bc-f905-ee764e3e82a3"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true" isItalic="false"/></textElement><text><![CDATA[Menor]]></text></staticText><staticText><reportElement positionType="Float" mode="Opaque" backcolor="#7A4E2D" forecolor="#FFFFFF" x="240" y="158" width="140" height="18" uuid="258f6a10-9b31-6cae-eb24-e0cbf7f95064"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true" isItalic="false"/></textElement><text><![CDATA[Documento]]></text></staticText><staticText><reportElement positionType="Float" mode="Opaque" backcolor="#7A4E2D" forecolor="#FFFFFF" x="380" y="158" width="90" height="18" uuid="f978c570-4a7d-a3c1-160f-9d82e501beba"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true" isItalic="false"/></textElement><text><![CDATA[Nacimiento]]></text></staticText><staticText><reportElement positionType="Float" mode="Opaque" backcolor="#7A4E2D" forecolor="#FFFFFF" x="470" y="158" width="70" height="18" uuid="affed63a-9948-fa5c-a4c6-40a123afff9a"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true" isItalic="false"/></textElement><text><![CDATA[Edad]]></text></staticText></band></title>
	<detail><band height="16"><printWhenExpression><![CDATA[$F{MENOR} != null]]></printWhenExpression><frame><reportElement style="Fila" x="0" y="0" width="540" height="16" uuid="08f90c1a-4171-5536-1a5c-4b8d297e0d78"/></frame><textField isBlankWhenNull="true"><reportElement x="0" y="0" width="240" height="16" uuid="2cad8fa4-7bbe-f282-badb-b8de5374b894"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{MENOR}]]></textFieldExpression></textField><textField isBlankWhenNull="true"><reportElement x="240" y="0" width="140" height="16" uuid="0e5757b5-a0e1-851e-0000-7c2eddf5a7f8"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{DOC_MENOR}]]></textFieldExpression></textField><textField isBlankWhenNull="true"><reportElement x="380" y="0" width="90" height="16" uuid="b3cb7cef-4ae4-d2f3-61ea-39964c2baf82"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{NACIMIENTO_MENOR}]]></textFieldExpression></textField><textField isBlankWhenNull="true"><reportElement x="470" y="0" width="70" height="16" uuid="368969db-7502-5626-2eb1-0ce6338d8756"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{EDAD_MENOR} + " años"]]></textFieldExpression></textField></band></detail>
	<pageFooter><band height="26"><line><reportElement forecolor="#C9D3CB" x="0" y="2" width="540" height="1" uuid="c3992e9a-68c5-ae12-bd18-488bc579b30d"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line><staticText><reportElement forecolor="#5F6368" x="0" y="5" width="420" height="20" uuid="4a47d298-3c8b-d392-b120-b627e0e1cab4"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="false" isItalic="true"/></textElement><text><![CDATA[Documento generado por QuindioStay, proyecto académico de Bases de Datos I - Universidad del Quindío.]]></text></staticText><textField isBlankWhenNull="true"><reportElement forecolor="#5F6368" x="420" y="5" width="120" height="20" uuid="cd58ed13-04bf-4f9e-a2e7-ae14ca5d7b77"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA["Generado " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField></band></pageFooter>
	<summary><band height="200"><textField isBlankWhenNull="true"><reportElement forecolor="#7A4E2D" x="0" y="6" width="540" height="18" uuid="87682805-257e-619d-49b8-e0dfdc14affa"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="true"/></textElement><textFieldExpression><![CDATA[$V{REPORT_COUNT} == 0 || $F{MENOR} == null ? "Esta reserva no tiene menores de edad: no requiere autorización." : ""]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="0" y="30" width="540" height="30" uuid="c6f32964-ed71-a81a-16b0-c3e047350c06"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="true"/></textElement><text><![CDATA[Esta autorización se presenta junto con el documento de identidad de cada menor y del adulto responsable. Para viajes fuera del país se requiere además el permiso notarial y los requisitos de Migración Colombia.]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="0" y="70" width="540" height="15" uuid="521255db-815e-b7f2-e44d-31ce130352c9"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA["Firmado en ______________________ el día ______ de ______________ de ________."]]></textFieldExpression></textField><line><reportElement forecolor="#202124" x="0" y="150" width="230" height="1" uuid="ad7f37e5-219b-3ef5-3b35-2ec07427d460"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line><textField isBlankWhenNull="true"><reportElement x="0" y="152" width="230" height="14" uuid="0c12b70f-8572-33c8-0c6b-eb1ac6c93bff"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{CLIENTE}]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="0" y="165" width="230" height="13" uuid="c5641d04-8b6b-5ad8-eb65-8636f87233a8"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false"/></textElement><text><![CDATA[Firma del padre, madre o representante legal]]></text></staticText><textField isBlankWhenNull="true"><reportElement forecolor="#5F6368" x="0" y="180" width="230" height="13" uuid="b9188354-7850-14da-419d-dd5ce88562b9"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA["C.C. / documento: " + $F{DOC_CLIENTE}]]></textFieldExpression></textField><line><reportElement forecolor="#202124" x="310" y="150" width="230" height="1" uuid="bb52d748-6786-7c06-2133-a9f3d3d4544b"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line><textField isBlankWhenNull="true"><reportElement x="310" y="152" width="230" height="14" uuid="5761e15e-66ef-0ea4-176f-233ce239f99c"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{AGENCIA}]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="310" y="165" width="230" height="13" uuid="43423451-784b-5c6b-142d-0337f330ffdd"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false"/></textElement><text><![CDATA[Recibido por la agencia]]></text></staticText></band></summary>
