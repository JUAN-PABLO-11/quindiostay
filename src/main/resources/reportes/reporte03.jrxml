	<queryString language="SQL"><![CDATA[SELECT estado,
       COUNT(*) AS cantidad,
       ROUND(100 * COUNT(*) / SUM(COUNT(*)) OVER (), 1) AS porcentaje
  FROM cotizacion
 GROUP BY estado
 ORDER BY cantidad DESC]]></queryString>
	<field name="ESTADO" class="java.lang.String"/>
	<field name="CANTIDAD" class="java.math.BigDecimal"/>
	<field name="PORCENTAJE" class="java.math.BigDecimal"/>
	<variable name="TOTAL_CANTIDAD" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{CANTIDAD}]]></variableExpression></variable>
