	<property name="net.sf.jasperreports.export.pdf.metadata.title" value="QuindioStay"/>
	<style name="Base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#202124"/>
	<style name="Fila" mode="Transparent">
		<conditionalStyle>
