alic="false"/></textElement><text><![CDATA[TITULAR DE LOS DATOS]]></text></staticText><line><reportElement forecolor="#2E5E3A" x="0" y="76" width="540" height="1" uuid="5717490c-d174-70a6-79e7-b314ba139a95"/><graphicElement><pen lineWidth="1.0"/></graphicElement></line><staticText><reportElement forecolor="#5F6368" x="0" y="80" width="90" height="15" uuid="4ddcf81f-fc43-75a8-ebbb-7c8fe80896b8"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><text><![CDATA[Nombre]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="90" y="80" width="180" height="15" uuid="5194560b-0430-25aa-ce0e-d2cce1022c88"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{CLIENTE}]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="0" y="95" width="90" height="15" uuid="7d49c3e7-fa0a-529b-bcd3-5b3c858e886e"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><text><![CDATA[Documento]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="90" y="95" width="180" height="15" uuid="9de797c1-7269-a095-2a3d-907f9e67231d"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{DOC_CLIENTE}]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="0" y="110" width="90" height="15" uuid="b528a955-8451-473d-aa88-93cd98e52e54"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><text><![CDATA[Ciudad]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="90" y="110" width="180" height="15" uuid="8009ca7d-3053-23bf-a354-87b2a33ade60"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{CIUDAD_ORIGEN}]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="270" y="80" width="90" height="15" uuid="d9a60f20-9d6a-19d8-806f-0762b296f8cf"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><text><![CDATA[Correo]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="360" y="80" width="180" height="15" uuid="d2411b89-90b1-f803-772e-bdf14fb19f21"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{CORREO}]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="270" y="95" width="90" height="15" uuid="e00e9c15-65d5-a865-d254-acdfa668627d"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><text><![CDATA[Teléfono]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="360" y="95" width="180" height="15" uuid="0878c184-a8c7-2840-a40e-11e70c54ded4"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{TELEFONO}]]></textFieldExpression></textField><staticText><reportElement forecolor="#5F6368" x="270" y="110" width="90" height="15" uuid="496dda9e-dee5-f029-c4e5-f3f9a00c1c3f"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><text><![CDATA[Cuenta]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="360" y="110" width="180" height="15" uuid="98646520-ecdb-a0e0-2ce8-e281b94d0be7"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{CUENTA}]]></textFieldExpression></textField><staticText><reportElement forecolor="#2E5E3A" x="0" y="136" width="540" height="18" uuid="78d7fbdc-cfc6-e89a-5164-8ad47d947fcf"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true" isItalic="false"/></textElement><text><![CDATA[AUTORIZACIÓN]]></text></staticText><line><reportElement forecolor="#2E5E3A" x="0" y="154" width="540" height="1" uuid="553baa43-a2f6-d0df-778a-560668ed6517"/><graphicElement><pen lineWidth="1.0"/></graphicElement></line><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="160" width="540" height="250" uuid="93837252-43f9-c7f6-f61b-00b93c6c9699"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Top"><font size="10" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA["De acuerdo con la Ley 1581 de 2012 y el Decreto 1074 de 2015, yo, " + $F{CLIENTE} + ", identificado(a) con " + $F{DOC_CLIENTE} + ", autorizo de manera previa, expresa e informada a QuindioStay y a los prestadores turísticos con los que haga reservas para recolectar, almacenar, usar y actualizar mis datos personales (nombre, documento, correo, teléfono, fecha de nacimiento y ciudad de origen) y los de los pasajeros que registre, con las siguientes finalidades:\n\n1. Gestionar mis reservas, pagos, cotizaciones y la prestación de los servicios turísticos contratados.\n2. Enviarme confirmaciones, recordatorios y cambios de estado por el canal que elegí (" + $F{CANAL} + ").\n3. Cumplir las obligaciones legales del sector turismo, como el Registro Nacional de Turismo y la facturación.\n4. Enviarme promociones y novedades: " + $F{PROMOCIONES} + " lo autorizo.\n\nComo titular tengo derecho a conocer, actualizar, rectificar y suprimir mis datos, a solicitar prueba de esta autorización y a revocarla cuando lo desee, escribiendo a datos@quindiostay.co o desde la opción Mi perfil de la plataforma. Mis datos no se venderán ni se compartirán con terceros distintos de los prestadores que atienden mis reservas. Las contraseñas se guardan cifradas."]]></textFieldExpression></textField><textField isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="420" width="540" height="15" uuid="7eba070b-61ec-a07f-f369-f4b56a447537"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false"/></textElement><textFieldExpression><![CDATA["Ciudad y fecha: ______________________, " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></textFieldExpression></textField><line><reportElement positionType="Float" forecolor="#202124" x="0" y="500" width="250" height="1" uuid="95d7ca77-4e46-6da8-9530-a99e30356306"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line><textField isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="502" width="250" height="14" uuid="e9492663-9774-d1ea-fcbc-629369c31831"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{CLIENTE}]]></textFieldExpression></textField><staticText><reportElement positionType="Float" forecolor="#5F6368" x="0" y="515" width="250" height="13" uuid="46714592-67e7-490a-1c26-e95ec8f78eaa"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false"/></textElement><text><![CDATA[Firma del titular]]></text></staticText></band></title>
