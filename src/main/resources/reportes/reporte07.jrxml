	<property name="net.sf.jasperreports.export.pdf.metadata.title" value="QuindioStay"/>
	<style name="Base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#202124"/>
	<style name="Fila" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F4F7F5"/>
		</conditionalStyle>
	</style>
	<queryString language="SQL"><![CDATA[SELECT TO_CHAR(pg.fecha_pago, 'YYYY-MM') AS mes,
       r.canal,
       SUM(pg.monto) AS recaudo,
       COUNT(*)      AS pagos
  FROM pago pg
  JOIN reserva r ON r.id_reserva = pg.id_reserva
 WHERE pg.estado_pago = 'exitoso'
 GROUP BY TO_CHAR(pg.fecha_pago, 'YYYY-MM'), r.canal
 ORDER BY mes, r.canal]]></queryString>
	<field name="MES" class="java.lang.String"/>
	<field name="CANAL" class="java.lang.String"/>
	<field name="PAGOS" class="java.math.BigDecimal"/>
	<field name="RECAUDO" class="java.math.BigDecimal"/>
	<variable name="TOTAL_PAGOS" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{PAGOS}]]></variableExpression></variable>
	<variable name="TOTAL_RECAUDO" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{RECAUDO}]]></variableExpression></variable>
