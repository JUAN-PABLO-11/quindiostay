	<property name="net.sf.jasperreports.export.pdf.metadata.title" value="QuindioStay"/>
	<style name="Base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#202124"/>
	<style name="Fila" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F4F7F5"/>
		</conditionalStyle>
	</style>
	<queryString language="SQL"><![CDATA[SELECT temporada, paquete, pasajeros, reservas,
       RANK() OVER (PARTITION BY temporada ORDER BY pasajeros DESC) AS puesto
  FROM (SELECT temporada(s.fecha_inicio)    AS temporada,
               p.nombre                     AS paquete,
               COUNT(rp.id_pasajero)        AS pasajeros,
               COUNT(DISTINCT r.id_reserva) AS reservas
          FROM reserva r
          JOIN salida s            ON s.id_salida   = r.id_salida
          JOIN paquete p           ON p.id_paquete  = s.id_paquete
          JOIN reserva_pasajero rp ON rp.id_reserva = r.id_reserva
         WHERE r.estado <> 'cancelada'
           AND p.visibilidad = 'publico'
         GROUP BY temporada(s.fecha_inicio), p.nombre)
 ORDER BY CASE temporada WHEN 'alta' THEN 1 WHEN 'media' THEN 2 ELSE 3 END, puesto]]></queryString>
	<field name="TEMPORADA" class="java.lang.String"/>
	<field name="PUESTO" class="java.math.BigDecimal"/>
	<field name="PAQUETE" class="java.lang.String"/>
	<field name="PASAJEROS" class="java.math.BigDecimal"/>
	<field name="RESERVAS" class="java.math.BigDecimal"/>
	<variable name="TOTAL_PASAJEROS" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{PASAJEROS}]]></variableExpression></variable>
	<variable name="TOTAL_RESERVAS" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{RESERVAS}]]></variableExpression></variable>
